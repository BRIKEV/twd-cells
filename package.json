{
  "private": true,
  "name": "twd-cells",
  "description": "An example application built using Lit and Open Cells",
  "license": "Apache-2.0",
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ci": "COVERAGE=true vite",
    "build": "tsc && vite build",
    "preview": "npm run build && vite preview",
    "test": "playwright test",
    "coverage:report": "nyc report --reporter=text --reporter=html"
  },
  "dependencies": {
    "@material/web": "^1.2.0",
    "@open-cells/core": "^1.1.2",
    "@open-cells/element-controller": "^1.0.4",
    "@open-cells/page-controller": "^1.0.4",
    "@open-cells/page-mixin": "^1.2.2",
    "@open-cells/page-transitions": "^1.0.2",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.5",
    "nyc": "^18.0.0",
    "playwright": "^1.0.0",
    "twd-js": "^1.8.2",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "engines": {
    "node": ">=18.15.0",
    "npm": ">=7.0.0"
  }
}
